# Google Gemini API Key (optional - NagarSetu falls back to rule-based logic if not provided)
# Note: Keep secrets server-side; NEVER prefix with NEXT_PUBLIC_
GEMINI_API_KEY=

# Gemini Model identifier
GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom SQLite database path (defaults to ./data/nagarsetu.db)
# DATABASE_PATH=./data/nagarsetu.db
